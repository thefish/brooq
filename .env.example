# Пример окружения brooq. Скопируйте в .env и заполните.
# .env в git не попадает; секреты — только здесь или в systemd
# LoadCredential (ADR-0003).

# --- База данных (обязательно) -------------------------------------------
# Очередь живёт в PostgreSQL: без DSN процесс не стартует (fail-fast).
DATABASE_URL=postgres://brooq:brooq@localhost:5432/brooq?sslmode=disable

# --- Служебная поверхность ------------------------------------------------
# /healthz и /metrics. Только loopback: публикацию наружу делает nginx,
# если она вообще нужна (ADR-0009).
HTTP_ADDR=127.0.0.1:8090

# --- Логирование ----------------------------------------------------------
# debug | info | warn | error
LOG_LEVEL=info
# json (прод) | text (локально)
LOG_FORMAT=text

# --- Движок очереди ------------------------------------------------------
# Значения ниже — дефолты из кода (pkg/config); раскомментируйте, чтобы
# переопределить. Длительности — с единицами (s, m, h).
# Число воркеров (свободных мест) на каждую тему.
# QUEUE_WORKERS=1
# Период поллинга готовых заданий.
# QUEUE_POLL_INTERVAL=1s
# Срок аренды взятого задания; продлевается heartbeat-ом (D13), пока
# обработчик жив, поэтому не обязан вмещать всю попытку.
# QUEUE_LEASE=2m
# Время одной попытки: истечение — сбой с повтором.
# QUEUE_ATTEMPT_TIMEOUT=1m
# Жёсткий потолок исполнения темы; не меньше QUEUE_ATTEMPT_TIMEOUT.
# QUEUE_MAX_EXECUTION_TIMEOUT=5m
# Границы отсрочки между попытками.
# QUEUE_BACKOFF_BASE=1s
# QUEUE_BACKOFF_MAX=1m
# Потолок попыток: после него задание становится dead.
# QUEUE_MAX_ATTEMPTS=5
# Период возврата истёкших аренд. По умолчанию не задан — считается из
# QUEUE_LEASE как max(5s, QUEUE_LEASE/4).
# QUEUE_REAPER_PERIOD=30s
# Грация после отмены контекста попытки: не вышел обработчик — ERROR в
# лог и brooq_hung_workers_total. По умолчанию не задана — равна
# QUEUE_LEASE.
# QUEUE_WATCHDOG_GRACE=2m
# Период сбора статистики для gauge-метрик (brooq_jobs,
# brooq_ready_oldest_age_seconds). 0 — дефолт движка 30s.
# QUEUE_STATS_PERIOD=0
# Сколько терминальное задание (done, dead, canceled) живёт после
# перехода в терминальное состояние. По умолчанию 720h (30 дней).
# QUEUE_RETENTION_TTL=0 выключает уборку: терминальные строки остаются
# навсегда.
# QUEUE_RETENTION_TTL=720h
# Размер одной пачки удаления уборки. По умолчанию 1000.
# QUEUE_RETENTION_BATCH=1000
# Период уборки. 0 — вычислить из QUEUE_RETENTION_TTL: сутки, зажатые в
# [1h, 24h].
# QUEUE_RETENTION_PERIOD=0

# --- Деплой ---------------------------------------------------------------
# Параметры подключения к VPS для make deploy. Обычно их держат в
# deploy/vars.mk (он не версионируется, шаблон — vars.mk.example); здесь
# можно задать те же ключи — .env подключается раньше и перекрывает файл.
# VPS_HOST=vps.example.com
# VPS_USER=deploy
# VPS_DIR=/opt/brooq

# --- Тесты ----------------------------------------------------------------
# Нужен для интеграционных тестов (pkg/postgres): тесты создают
# изолированную схему, накатывают migrations/ и убирают её.
# Поднять локальную базу: make test-db-up
# TEST_DATABASE_URL=postgres://brooq:brooq@localhost:55433/brooq_test?sslmode=disable
